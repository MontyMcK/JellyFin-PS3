	    ../source/video/mkv_ts.cpp ../source/player/stream/stream_local.cpp ../source/offline/dl_ts.cpp h264_sps_p.o lang_names_p.o aac_adts_p.o flac_dec_p.o resample_p.o ../source/i18n/i18n.c ../source/i18n/i18n_tables.c -lm

# lfs: drives, hotplug, paths, listings and reads, over directory trees and the NTFS / exFAT images.
LFS_SRC = test_lfs.cpp lfs_port_host.cpp ../source/local/lfs.cpp ../source/local/lfs_path.cpp
test_lfs: $(LFS_SRC) mohasi_host_storage.c ../source/local/lfs.h ../source/local/lfs_port.h           ../source/local/lfs_path.h $(wildcard ../third_party/mohasi_fs/*.h) $(wildcard fixtures/fs/*.img.gz)
	$(CC) -O2 -Wall -Wno-misleading-indentation -I../third_party/mohasi_fs -c -o mohasi_ntfs.o ../third_party/mohasi_fs/ntfs.c
	$(CC) -O2 -Wall -Wno-misleading-indentation -I../third_party/mohasi_fs -c -o mohasi_exfat.o ../third_party/mohasi_fs/exfat.c
	$(CC) -O2 -Wall -I../third_party/mohasi_fs -c -o mohasi_storage.o mohasi_host_storage.c
	$(CXX) -O2 -Wall -Wextra -I../source/local -I../source/i18n -I../third_party/mohasi_fs -o $@ $(LFS_SRC) ../source/i18n/i18n.c ../source/i18n/i18n_tables.c mohasi_ntfs.o mohasi_exfat.o mohasi_storage.o -lpthread

# The vendored NTFS / exFAT readers (third_party/mohasi_fs) against images made by the Linux
# drivers (fixtures/fs/make_images.sh), on a fake storage device that reads the image.
MOHASI     = ../third_party/mohasi_fs
MOHASI_SRC = test_mohasi_fs.c mohasi_host_storage.c $(MOHASI)/ntfs.c $(MOHASI)/exfat.c
MOHASI_DEP = $(MOHASI_SRC) $(MOHASI)/ntfs.h $(MOHASI)/exfat.h $(MOHASI)/jf_port.h \
             $(wildcard fixtures/fs/*.img.gz)
test_mohasi_fs: $(MOHASI_DEP)
	$(CC) -O2 -Wall -Wextra -Wno-misleading-indentation -I$(MOHASI) -o $@ $(MOHASI_SRC)

# exFAT stays read-only: exfat.c must not grow a write path back (no write syscall, no raw syscall
# trampolines, no allocator).  NTFS writes, through jf_port.h's writeStorageRaw only.
# (Comments are stripped first; the wording of a comment is not code.)
check-mohasi-readonly:
	@bad=$$(sed -e 's@//.*@@' $(MOHASI)/exfat.c | grep -n -E '\b603\b|STORAGE_WRITE|writeSectors|writeStorageRaw|allocateClusters|scCall|sys_storage_write' \
	        | sed "s@^@$(MOHASI)/exfat.c: @"; \
	    sed -e 's@//.*@@' $(MOHASI)/ntfs.c | grep -n -E '\b603\b|scCall|sys_storage_write|lv2syscall' \
	        | sed "s@^@$(MOHASI)/ntfs.c: @"); \
	if [ -n "$$bad" ]; then echo "write path or raw syscall found where it must not be:"; echo "$$bad"; exit 1; fi; \
	echo "mohasi: exFAT read-only, NTFS writes only through jf_port"

# The same, built big-endian and run under qemu-ppc64 (skipped when the cross compiler is missing).
test_mohasi_fs_be: $(MOHASI_DEP)
	@if command -v powerpc64-linux-gnu-gcc >/dev/null && command -v qemu-ppc64 >/dev/null; then \
	    powerpc64-linux-gnu-gcc -static -O2 -Wall -Wno-misleading-indentation -I$(MOHASI) -o $@ $(MOHASI_SRC) && \
	    qemu-ppc64 ./$@; \
	else echo "test_mohasi_fs_be: no powerpc64 cross compiler or qemu-ppc64, skipped"; fi

test_dts_hd: test_dts_hd.c $(DTS_HD_DEPS)
	$(CC) $(DCAHD_CFLAGS) $(CFLAGS) -o $@ $^ -lm

# XLL -- the actual lossless data -- cannot be covered by a SYNTHESISED
# fixture, because no free DTS-HD MA encoder exists.  It can be covered by an
# EXTRACTED one, which is what test_dts_xll_dump is for:
#
#   ffmpeg -ss 00:52:00 -i <rip.mkv> -map 0:<dts-hd-ma-idx> -t 8 -c:a copy \
#          -f dts dtsma.dts
#   ffmpeg -i dtsma.dts -c:a pcm_s32le -f s32le dtsma.ref
#   ./test_dts_xll_dump dtsma.dts ours.pcm && cmp ours.pcm dtsma.ref
#
# DTS-HD MA is lossless, so dtsma.ref is an EXACT reference and cmp is a real
# pass/fail rather than a tolerance check.  Seek to a point well inside the
# film: a cut landing mid-frame makes the first frame decode without its core
# and that one frame will differ for reasons that are not the decoder's.
#
# Build it big-endian too, which is the whole point on a PPU target:
#   powerpc64-linux-gnu-gcc -O2 -static $(DCAHD_CFLAGS) $(CFLAGS) \
#       -o dump_be test_dts_xll_dump.c $(DTS_HD_DEPS) -lm
#   qemu-ppc64 ./dump_be dtsma.dts be.pcm && cmp be.pcm dtsma.ref
test_dts_xll_dump: test_dts_xll_dump.c $(DTS_HD_DEPS)
	$(CC) $(DCAHD_CFLAGS) $(CFLAGS) -o $@ $^ -lm

# ---------------------------------------------------------------------------
# Byte-order agreement -- `make -f Makefile.host endian`
# ---------------------------------------------------------------------------
# The DTS-HD MA path spent a while suspected of a big-endian bug that could
# only be found "with hardware in the loop".  It was not endianness at all
# (see ../source/audio/dcahd/PROVENANCE.md), but the way that was PROVED is
# worth keeping runnable instead of leaving it as a shell command in a note:
# build the identical decoder for big-endian PPC64, run it under qemu, and
# compare byte for byte with the host build.
#
# test_dts_xll_dump writes every sample explicitly little-endian, byte by
# byte, so the output file encodes VALUES rather than the host's byte order.
# The two runs therefore match if and only if the two builds compute the same
# numbers.
#
# The big-endian build deliberately uses -O3 -maltivec, which is what the PS3
# Makefile gives these objects (dcahd_api.o / dcahd_xll.o / dcahd_compat.o get
# -O3, and -mcpu=cell implies AltiVec).  That matters: -O3 turns on
# -ftree-vectorize, and auto-vectorised big-endian PowerPC is exactly where a
# byte-order bug would hide.  Building at -O2 would test the wrong thing.
#
# ENDIAN_FIXTURE defaults to the synthesised core-only tones, which exercises
# the CORE path -- and the core is on the lossless critical path, because
# DTS-HD MA is usually residual-encoded (lossless = core + residual).  To cover
# XLL itself, point it at a fixture extracted from a real disc rip:
#
#   make -f Makefile.host endian ENDIAN_FIXTURE=dtsma.dts
#
PPC64CC        ?= powerpc64-linux-gnu-gcc
QEMU_PPC64     ?= qemu-ppc64
ENDIAN_FIXTURE ?= tones51.dts

.PHONY: endian
endian: $(ENDIAN_FIXTURE)
	@echo "== building little-endian (host) =="
	@$(CC) $(DCAHD_CFLAGS) $(CFLAGS) -o dump_le test_dts_xll_dump.c $(DTS_HD_DEPS) -lm
	@echo "== building big-endian ppc64, -O3 -maltivec (the console's flags) =="
	@$(PPC64CC) $(DCAHD_CFLAGS) $(CFLAGS) -O3 -maltivec -mabi=altivec -static \
	    -o dump_be test_dts_xll_dump.c $(DTS_HD_DEPS) -lm
	@echo "== little-endian run =="
	@./dump_le $(ENDIAN_FIXTURE) out_le.pcm
	@echo "== big-endian run (under qemu) =="
	@$(QEMU_PPC64) ./dump_be $(ENDIAN_FIXTURE) out_be.pcm
	@if cmp -s out_le.pcm out_be.pcm; then \
	    echo "PASS: byte-identical across byte orders ($(ENDIAN_FIXTURE))"; \
	else \
	    echo "FAIL: the two byte orders disagree --"; \
	    cmp -l out_le.pcm out_be.pcm | wc -l; \
	    exit 1; \
	fi

tones51.ac3:
	ffmpeg -y -loglevel error \
	  -f lavfi -i "sine=frequency=300:duration=2" \
	  -f lavfi -i "sine=frequency=500:duration=2" \
	  -f lavfi -i "sine=frequency=700:duration=2" \
	  -f lavfi -i "sine=frequency=60:duration=2" \
	  -f lavfi -i "sine=frequency=900:duration=2" \
	  -f lavfi -i "sine=frequency=1100:duration=2" \
	  -filter_complex "join=inputs=6:channel_layout=5.1(side):map=0.0-FL|1.0-FR|2.0-FC|3.0-LFE|4.0-SL|5.0-SR[a]" \
	  -map "[a]" -c:a ac3 -b:a 640k -ar 48000 $@

tones51.dts:
	ffmpeg -y -loglevel error \
	  -f lavfi -i "sine=frequency=300:duration=2" \
	  -f lavfi -i "sine=frequency=500:duration=2" \
	  -f lavfi -i "sine=frequency=700:duration=2" \
	  -f lavfi -i "sine=frequency=60:duration=2" \
	  -f lavfi -i "sine=frequency=900:duration=2" \
	  -f lavfi -i "sine=frequency=1100:duration=2" \
	  -filter_complex "join=inputs=6:channel_layout=5.1(side):map=0.0-FL|1.0-FR|2.0-FC|3.0-LFE|4.0-SL|5.0-SR[a]" \
	  -map "[a]" -c:a dca -strict -2 -b:a 1509k -ar 48000 -f dts $@

tones51.thd:
	ffmpeg -y -loglevel error \
	  -f lavfi -i "sine=frequency=300:duration=2" \
	  -f lavfi -i "sine=frequency=500:duration=2" \
	  -f lavfi -i "sine=frequency=700:duration=2" \
	  -f lavfi -i "sine=frequency=60:duration=2" \
	  -f lavfi -i "sine=frequency=900:duration=2" \
	  -f lavfi -i "sine=frequency=1100:duration=2" \
	  -filter_complex "join=inputs=6:channel_layout=5.1(side):map=0.0-FL|1.0-FR|2.0-FC|3.0-LFE|4.0-SL|5.0-SR[a]" \
	  -map "[a]" -c:a truehd -strict -2 -ar 48000 -f truehd $@

# TrueHD is lossless, so ffmpeg's own decode of the same file is an exact
# reference, not just a sanity check — test_truehd_decode compares against it
# sample for sample.
tones51.thd.ref: tones51.thd
	ffmpeg -y -loglevel error -i tones51.thd -c:a pcm_s32le -f s32le $@

