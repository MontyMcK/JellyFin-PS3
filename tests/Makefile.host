	$(CC) $(CFLAGS) -Wextra -I../source/local -c -o local_resume_host.o ../source/local/local_resume.c
	$(CXX) $(CXXFLAGS) -Wextra -I../source/local -o $@ test_local_resume.cpp local_resume_host.o

# The demuxer's audio-track choice over the TS fixtures, and the stream clock of a file entered part way.
test_local_play: test_local_play.cpp $(PROBE_SRC) ../source/video/ts_demux.cpp ../source/video/ts_demux.h \
                 ../source/player/stream/stream_local.h $(wildcard fixtures/ts/*)
	$(CC) $(CFLAGS) -c -o h264_sps_p.o ../source/video/h264_sps.c
	$(CC) $(CFLAGS) -c -o lang_names_p.o ../source/util/lang_names.c
	$(CC) $(CFLAGS) -c -o aac_adts_p.o ../source/audio/aac_adts.c
	$(CC) $(CFLAGS) -c -o flac_dec_p.o ../source/audio/flac_dec.c
