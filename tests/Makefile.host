# Host-side (x86) tests for the surround audio paths.
# Builds the SAME vendored liba52 / libdca / FFmpeg-MLP decoders and the SAME
# channel maps, framing and track-label logic the PS3 build compiles.
#
#   make -f Makefile.host          # build every test
#   make -f Makefile.host check    # build + generate tones with ffmpeg + run
#
# Requires: cc, and ffmpeg for the decode tests' input files.  The DTS and
# TrueHD tone files need ffmpeg's `dca` and `truehd` encoders, which are
# experimental (hence -strict -2) but good enough to carry a distinct tone per
# channel.  Note ffmpeg's truehd encoder tops out at 5.1, so the 7.1 path is
# covered by test_truehd_map rather than by an end-to-end decode.

CC      ?= cc
CXX     ?= c++
CFLAGS  ?= -O2 -Wall
CFLAGS  += -I../source/audio -I../source/audio/a52 -I../source/util -I../source/i18n
CXXFLAGS ?= -O2 -Wall
CXXFLAGS += -I../source/api -I../source/net -I../source/i18n

A52_DIR  = ../source/audio/a52
A52_SRCS = $(A52_DIR)/parse.c $(A52_DIR)/bit_allocate.c $(A52_DIR)/bitstream.c \
           $(A52_DIR)/downmix.c $(A52_DIR)/imdct.c
MAP_SRC  = ../source/audio/ac3_map.c

DCA_DIR  = ../source/audio/dca
DCA_SRCS = $(DCA_DIR)/dca_parse.c $(DCA_DIR)/dca_downmix.c \
           $(DCA_DIR)/dca_bitstream.c
DTS_MAP_SRC  = ../source/audio/dts_map.c
DTS_EXSS_SRC = ../source/audio/dts_exss.c
DTS_STREAM_SRC = ../source/audio/dts_stream.c
TRACK_SRC    = ../source/util/track_codec.c
PGS_SRC      = ../source/player/subtitles_pgs.c
TRICKPLAY_INFO_SRC = ../source/api/trickplay_info.c

# Vendored FFmpeg MLP/TrueHD decoder: mlp_api.c is the whole decoder in one
# translation unit (source/audio/mlp/PROVENANCE.md), so only it and the
# runtime shim are compiled here.
MLP_CFLAGS = -I../source/audio/mlp/ff -I../source/audio/mlp/ff/libavcodec \
             -Wno-dangling-else
TRUEHD_SRCS = ../source/audio/truehd_stream.c ../source/audio/truehd_map.c \
              ../source/audio/mlp_api.c ../source/audio/mlp_compat.c

# Vendored FFmpeg DTS decoder with DTS-HD MA (XLL).  Same include ORDER rule
# as MLP: the FFmpeg headers' `#include "config.h"` must find ff/config.h and
# not liba52's, so DCAHD_CFLAGS goes BEFORE CFLAGS.
DCAHD_CFLAGS = -I../source/audio/mlp/ff -I../source/audio/mlp/ff/libavcodec \
               -I../source/audio/dcahd
DCAHD_SRCS = ../source/audio/dcahd_api.c ../source/audio/dcahd_xll.c \
             ../source/audio/dcahd_compat.c \
             ../source/audio/mlp_api.c ../source/audio/mlp_compat.c
DTS_HD_DEPS = $(DTS_STREAM_SRC) $(DTS_MAP_SRC) $(DTS_EXSS_SRC) $(DCA_SRCS) \
              ../source/audio/truehd_map.c $(DCAHD_SRCS)

all: test_wave_scope test_ac3_map test_ac3_decode test_iec61937 test_media_sources test_subtitles \
     test_subtitles_pgs test_trickplay_info test_media_segments \
     test_dts_map test_dts_decode test_dts_stream test_dts_exss test_track_codec \
     test_truehd_map test_truehd_decode \
     test_dts_hd test_dts_xll_dump test_text_runs test_utf8 test_theme test_layout test_circle_blit \
     test_wave_kernel test_wave_spline test_wave_ribbon test_wave_field \
     test_wave_audio test_wave_motion test_wave_layers \
     test_wave_cam test_wave_light test_wave_gel test_spine test_depth test_facts test_stream_budget \
     test_experience test_json_unescape test_boot_seq test_wave_motes \
     test_wave_nav test_daynight test_canyon test_display_mode test_wave_look test_wave_drop test_offline test_stream_request test_jbuf_order \
     test_settings_model test_settings_model_nostats test_userdata test_livetv test_server_discovery test_rx_gap test_livetv_prefs test_chapters test_wol test_icons test_live_watch test_picture_resume test_mohasi_fs test_lfs_path test_lfs test_h264_sps test_mkv_demux test_mkv_ts test_local_probe test_local_play test_local_names test_local_resume test_resample test_aac test_flac test_lossless test_sub_conv test_local_subs test_local_tags test_local_audio test_local_music test_music_engine test_i18n test_i18n_text test_line_break test_clock_fmt

test_iec61937: test_iec61937.c ../source/audio/iec61937.c $(A52_SRCS)
	$(CC) $(CFLAGS) -o $@ $^ -lm

# ffmpeg's spdif muxer is the reference for the IEC 61937 bursts.
tones51.spdif: tones51.ac3
	ffmpeg -y -loglevel error -i $< -c copy -f spdif $@

test_ac3_map: test_ac3_map.c $(MAP_SRC)
	$(CC) $(CFLAGS) -o $@ $^ -lm

test_ac3_decode: test_ac3_decode.c $(MAP_SRC) $(A52_SRCS)
	$(CC) $(CFLAGS) -o $@ $^ -lm

test_dts_map: test_dts_map.c $(DTS_MAP_SRC)
	$(CC) $(CFLAGS) -o $@ $^ -lm

test_dts_decode: test_dts_decode.c $(DTS_MAP_SRC) $(DCA_SRCS)
	$(CC) $(CFLAGS) -o $@ $^ -lm

test_dts_stream: test_dts_stream.c $(DTS_STREAM_SRC) $(DTS_MAP_SRC) $(DTS_EXSS_SRC) $(DCA_SRCS)
	$(CC) $(CFLAGS) -o $@ $^ -lm

test_dts_exss: test_dts_exss.c $(DTS_EXSS_SRC)
	$(CC) $(CFLAGS) -o $@ $^

test_track_codec: test_track_codec.c $(TRACK_SRC)
	$(CC) $(CFLAGS) -o $@ $^

test_truehd_map: test_truehd_map.c ../source/audio/truehd_map.c
	$(CC) $(CFLAGS) -o $@ $^ -lm

# MLP_CFLAGS must come BEFORE CFLAGS: three vendored trees each ship their own
# config.h, and CFLAGS puts liba52's directory on the include path, so the
# FFmpeg headers' `#include "config.h"` would otherwise pick up a52's.
test_truehd_decode: test_truehd_decode.c $(TRUEHD_SRCS)
	$(CC) $(MLP_CFLAGS) $(CFLAGS) -o $@ $^ -lm

# subtitles.cpp is compiled straight into the test with its console-only
# dependencies stubbed, so what is tested is the code the PS3 runs.
test_subtitles: test_subtitles.cpp ../source/player/subtitles.cpp $(PGS_SRC)
	$(CXX) $(CXXFLAGS) -o $@ test_subtitles.cpp $(PGS_SRC)

test_media_sources: test_media_sources.cpp ../source/api/media_sources.cpp ../source/api/version_summary.c
	$(CXX) $(CXXFLAGS) -o $@ $^

test_subtitles_pgs: test_subtitles_pgs.c $(PGS_SRC)
	$(CC) $(CFLAGS) -o $@ $^

test_media_segments: test_media_segments.c ../source/api/media_segments.c
	$(CC) $(CFLAGS) -I../source/api -o $@ $^ -lm

test_trickplay_info: test_trickplay_info.c $(TRICKPLAY_INFO_SRC)
	$(CC) $(CFLAGS) -o $@ $^

# Offline downloads: the SAME source/offline core the PS3 build compiles,
# with dl_platform.h backed by dl_fake.cpp (a real temp directory and a
# scripted fake HTTP server) instead of dl_ps3.cpp.  -Wextra because this
# code is new and can afford to be held to it.
OFFLINE_DIR  = ../source/offline
OFFLINE_SRCS = $(OFFLINE_DIR)/dl_model.cpp $(OFFLINE_DIR)/dl_http.cpp \
               $(OFFLINE_DIR)/dl_store.cpp $(OFFLINE_DIR)/dl_manager.cpp \
               $(OFFLINE_DIR)/dl_ts.cpp $(OFFLINE_DIR)/dl_request.cpp \
               $(OFFLINE_DIR)/dl_service.cpp $(OFFLINE_DIR)/dl_library.cpp \
               $(OFFLINE_DIR)/dl_ui.cpp $(OFFLINE_DIR)/dl_season.cpp \
               ../source/i18n/i18n.c ../source/i18n/i18n_tables.c
# Stage 3: the downloader shares the PLAYER's stream decision, so the test
# links the player's real stream_request.cpp and what it calls -- the real
# quality ladder (vquality.cpp), track labels (track_codec.c) and
# url_encode_query (jellyfin_api.cpp).  host/ppu-types.h stands in for
# PSL1GHT's integer typedefs; nothing else is stubbed.
SHARED_SRCS  = ../source/player/stream/stream_request.cpp \
               ../source/player/stream/stream_local.cpp \
               ../source/util/vquality.cpp ../source/util/jf_paths.cpp \
               ../source/api/jellyfin_api.cpp
OFFLINE_INC  = -I$(OFFLINE_DIR) -I../source/player/stream -I../source/api \
               -I../source/net -I../source/util -Ihost
track_codec_host.o: $(TRACK_SRC)
	$(CC) $(CFLAGS) -c -o $@ $<
test_offline: test_offline.cpp dl_fake.cpp dl_fake.h $(OFFLINE_SRCS) \
              $(SHARED_SRCS) track_codec_host.o $(wildcard $(OFFLINE_DIR)/*.h) \
              ../source/player/stream/stream_request.h \
              ../source/player/stream/stream_local.h
	$(CXX) $(CXXFLAGS) -Wextra $(OFFLINE_INC) -o $@ \
	    test_offline.cpp dl_fake.cpp $(OFFLINE_SRCS) $(SHARED_SRCS) \
	    track_codec_host.o

# Decode-order pictures leave the jitter buffer in timestamp order.
test_jbuf_order: test_jbuf_order.cpp ../source/video/jbuf.cpp
	$(CXX) $(CXXFLAGS) -Ihoststub -I../source/video -I../source/util -I../source -o $@ test_jbuf_order.cpp

# The stream request decision, pinned to byte-exact URLs.
test_stream_request: test_stream_request.cpp stream_golden_cases.h \
                     stream_golden_urls.inc $(SHARED_SRCS) track_codec_host.o \
                     ../source/player/stream/stream_request.h
	$(CXX) $(CXXFLAGS) -Wextra $(OFFLINE_INC) -I. -o $@ \
	    test_stream_request.cpp ../source/player/stream/stream_request.cpp \
	    ../source/util/vquality.cpp ../source/util/jf_paths.cpp \
	    ../source/api/jellyfin_api.cpp track_codec_host.o

# The Settings screen model (rows, sections, layout, scrolling), built with
# the player statistics row compiled in and out.
test_settings_model: test_settings_model.c ../source/ui/settings_model.c \
                     ../source/ui/settings_model.h ../source/net/update_page.h
	$(CC) $(CFLAGS) -Wextra -I../source/ui -I../source/net -o $@ \
	    test_settings_model.c ../source/ui/settings_model.c
test_settings_model_nostats: test_settings_model.c ../source/ui/settings_model.c \
                     ../source/ui/settings_model.h ../source/net/update_page.h
	$(CC) $(CFLAGS) -Wextra -DENABLE_PLAYER_STATS=0 -I../source/ui -I../source/net -o $@ \
	    test_settings_model.c ../source/ui/settings_model.c

# The favourite / played request builders (method and path).
test_userdata: test_userdata.cpp ../source/api/userdata_request.h
	$(CXX) $(CXXFLAGS) -Wextra -I../source/api -I../source/net -o $@ test_userdata.cpp

# Live TV: the parsers (against fixtures/livetv_*.json), the ISO-8601 time
# arithmetic and the channel list's rules.
test_livetv: test_livetv.cpp ../source/api/livetv.cpp ../source/api/livetv.h \
             ../source/api/json_lite.h fixtures/livetv_channels.json \
             fixtures/livetv_programs.json
	$(CXX) $(CXXFLAGS) -Wextra -I../source/api -o $@ test_livetv.cpp ../source/api/livetv.cpp

# The embedded icon font: every ICON_* has ink at the sizes the UI draws.
test_icons: test_icons.cpp ../source/ui/icons.h ../source/ui/fonts/tabler_icons.h
	$(CXX) $(CXXFLAGS) -I../source/gfx -I../source/ui -o $@ test_icons.cpp

# Wake-on-LAN: the MAC address text and the magic packet.
test_wol: test_wol.cpp ../source/net/wol.c ../source/net/wol.h
	$(CC) $(CFLAGS) -Wextra -I../source/net -c -o wol_t.o ../source/net/wol.c
	$(CXX) $(CXXFLAGS) -Wextra -I../source/net -o $@ test_wol.cpp wol_t.o

# Chapters: the item JSON's Chapters list and the menu labels.
test_chapters: test_chapters.cpp ../source/api/chapters.cpp ../source/api/chapters.h ../source/api/json_lite.h
	$(CXX) $(CXXFLAGS) -Wextra -I../source/api -o $@ test_chapters.cpp ../source/api/chapters.cpp

# Live TV, the viewer's own arrangement: hidden categories, recents, the pages offered.
test_livetv_prefs: test_livetv_prefs.cpp ../source/api/livetv_prefs.c ../source/api/livetv_prefs.h
	$(CC) $(CFLAGS) -Wextra -I../source/api -c -o livetv_prefs_t.o ../source/api/livetv_prefs.c
	$(CXX) $(CXXFLAGS) -Wextra -I../source/api -o $@ test_livetv_prefs.cpp livetv_prefs_t.o

# Server discovery: the UDP 7359 reply parser and the URL rules.
# Sender backoff seen from the receiving end (the stream's receive window).
test_rx_gap: test_rx_gap.cpp ../source/player/stream/rx_gap.h
	$(CXX) $(CXXFLAGS) -Wextra -I../source/player/stream -o $@ test_rx_gap.cpp

test_server_discovery: test_server_discovery.cpp ../source/net/server_discovery_parse.cpp \
                       ../source/net/server_discovery.h ../source/api/json_lite.h
	$(CXX) $(CXXFLAGS) -Wextra -I../source/net -o $@ test_server_discovery.cpp ../source/net/server_discovery_parse.cpp

# Live TV: when the player has to ask for a fresh stream (header-only rules).
test_picture_resume: test_picture_resume.cpp ../source/player/core/picture_size.h ../source/ui/xmb/ui_resume.cpp ../source/ui/xmb/ui_resume.h
	$(CXX) $(CXXFLAGS) -Wextra -I../source/player/core -I../source/ui/xmb -o $@ test_picture_resume.cpp ../source/ui/xmb/ui_resume.cpp

test_live_watch: test_live_watch.c ../source/player/core/live_watch.h
	$(CC) $(CFLAGS) -Wextra -I../source/player/core -o $@ test_live_watch.c

# Local files: path parsing and the browser's rules (pure).
test_lfs_path: test_lfs_path.cpp ../source/local/lfs_path.cpp ../source/local/lfs_path.h
	$(CXX) $(CXXFLAGS) -Wextra -I../source/local -o $@ test_lfs_path.cpp ../source/local/lfs_path.cpp

# H.264 sequence parameter sets: real x264 SPS units (fixtures/h264/make_sps.py).
test_h264_sps: test_h264_sps.cpp ../source/video/h264_sps.c ../source/video/h264_sps.h fixtures/h264/sps_fixtures.inc
	$(CC) $(CFLAGS) -Wextra -I../source/video -c -o h264_sps_host.o ../source/video/h264_sps.c
	$(CXX) $(CXXFLAGS) -Wextra -I../source/video -o $@ test_h264_sps.cpp h264_sps_host.o

# Matroska demuxer: hand-built files for the odd structures, ffmpeg-made ones for real data.
test_mkv_demux: test_mkv_demux.cpp mkv_builder.h ../source/video/mkv_demux.cpp ../source/video/mkv_demux.h $(wildcard fixtures/mkv/*)
	$(CXX) $(CXXFLAGS) -Wextra -I../source/video -o $@ test_mkv_demux.cpp ../source/video/mkv_demux.cpp

# Matroska as MPEG-TS, read back through the player's own TS demuxer (ts_demux.cpp, built against hoststub/).
test_mkv_ts: test_mkv_ts.cpp mkv_builder.h ../source/video/mkv_ts.cpp ../source/video/mkv_ts.h              ../source/video/mkv_demux.cpp ../source/video/ts_demux.cpp ../source/video/ts_demux.h $(wildcard fixtures/mkv/*)
	$(CC) $(CFLAGS) -c -o aac_adts_p.o ../source/audio/aac_adts.c
	$(CC) $(CFLAGS) -c -o flac_dec_p.o ../source/audio/flac_dec.c
	$(CC) $(CFLAGS) -c -o resample_p.o ../source/audio/resample.c
	$(CXX) $(CXXFLAGS) -Wextra -Ihoststub -I../source/video -I../source/util -I../source/audio -o $@ test_mkv_ts.cpp 	    ../source/video/mkv_ts.cpp ../source/video/mkv_demux.cpp ../source/video/ts_demux.cpp aac_adts_p.o flac_dec_p.o resample_p.o ../source/i18n/i18n.c ../source/i18n/i18n_tables.c -lm

# What a local video file is, which track to start with (Matroska, TS and m2ts fixtures).
PROBE_SRC = ../source/local/local_probe.cpp ../source/video/mkv_demux.cpp ../source/video/mkv_ts.cpp             ../source/video/h264_sps.c ../source/player/stream/stream_local.cpp ../source/offline/dl_ts.cpp             ../source/util/lang_names.c
test_local_probe: test_local_probe.cpp $(PROBE_SRC) ../source/local/local_probe.h $(wildcard fixtures/mkv/* fixtures/ts/*)
	$(CC) $(CFLAGS) -c -o h264_sps_p.o ../source/video/h264_sps.c
	$(CC) $(CFLAGS) -c -o lang_names_p.o ../source/util/lang_names.c
	$(CC) $(CFLAGS) -c -o aac_adts_p.o ../source/audio/aac_adts.c
	$(CC) $(CFLAGS) -c -o flac_dec_p.o ../source/audio/flac_dec.c
	$(CC) $(CFLAGS) -c -o resample_p.o ../source/audio/resample.c
	$(CXX) $(CXXFLAGS) -Wextra -I../source/local -I../source/video -I../source/util -I../source/audio -I../source/player/stream -I../source/offline 	    -o $@ test_local_probe.cpp ../source/local/local_probe.cpp ../source/video/mkv_demux.cpp ../source/video/mkv_ts.cpp 	    ../source/player/stream/stream_local.cpp ../source/offline/dl_ts.cpp h264_sps_p.o lang_names_p.o aac_adts_p.o flac_dec_p.o resample_p.o ../source/i18n/i18n.c ../source/i18n/i18n_tables.c -pthread -lm

# AAC: the ADTS and config helpers, the channel map, and the libfaad glue (adec_aac.cpp) with the resampler, over
# ffmpeg-made files.  Needs libfaad (apt: libfaad-dev).
test_aac: test_aac.cpp ../source/audio/aac_adts.c ../source/audio/chan_map.c ../source/audio/adec_aac.cpp ../source/audio/adec_out.cpp ../source/audio/resample.c \
          ../source/audio/aac_adts.h ../source/audio/chan_map.h ../source/audio/adec_aac.h $(wildcard fixtures/aac/*)
	$(CC) $(CFLAGS) -O2 -Wextra -c -o aac_adts_t.o ../source/audio/aac_adts.c
	$(CC) $(CFLAGS) -O2 -Wextra -c -o chan_map_t.o ../source/audio/chan_map.c
	$(CC) $(CFLAGS) -O2 -c -o resample_t.o ../source/audio/resample.c
	$(CXX) $(CXXFLAGS) -Wextra -Ihoststub -I../source/audio -I../source/util -o $@ test_aac.cpp ../source/audio/adec_aac.cpp ../source/audio/adec_out.cpp \
	    aac_adts_t.o chan_map_t.o resample_t.o -lfaad -lm

# FLAC and PCM from a Matroska file, end to end: mkv_ts, the demuxer, the slots, the decoders, what comes out.
test_lossless: test_lossless.cpp ../source/audio/adec_flac.cpp ../source/audio/adec_pcm.cpp ../source/audio/adec_out.cpp ../source/audio/flac_dec.c  ../source/audio/chan_map.c ../source/audio/resample.c ../source/video/mkv_ts.cpp ../source/video/mkv_demux.cpp ../source/video/ts_demux.cpp  ../source/audio/aac_adts.c $(wildcard fixtures/flac/*)
	$(CC) $(CFLAGS) -O2 -c -o flac_dec_l.o ../source/audio/flac_dec.c
	$(CC) $(CFLAGS) -O2 -c -o chan_map_l.o ../source/audio/chan_map.c
	$(CC) $(CFLAGS) -O2 -c -o resample_l.o ../source/audio/resample.c
	$(CC) $(CFLAGS) -O2 -c -o aac_adts_l.o ../source/audio/aac_adts.c
	$(CXX) $(CXXFLAGS) -Wextra -Ihoststub -I../source/video -I../source/util -I../source/audio -o $@ test_lossless.cpp ../source/audio/adec_flac.cpp  ../source/audio/adec_pcm.cpp ../source/audio/adec_out.cpp ../source/video/mkv_ts.cpp ../source/video/mkv_demux.cpp ../source/video/ts_demux.cpp  flac_dec_l.o chan_map_l.o resample_l.o aac_adts_l.o -lm

# The FLAC decoder, against ffmpeg-made files and frames made by the test's own encoder; built with the address and
# undefined-behaviour sanitizers.
test_flac: test_flac.cpp ../source/audio/flac_dec.c ../source/audio/flac_dec.h $(wildcard fixtures/flac/*)
	$(CC) -O1 -g -Wall -Wextra -fsanitize=address,undefined -fno-sanitize-recover=undefined -c -o flac_dec_t.o ../source/audio/flac_dec.c
	$(CXX) -O1 -g -Wall -Wextra -fsanitize=address,undefined -fno-sanitize-recover=undefined -I../source/audio -o $@ test_flac.cpp flac_dec_t.o -lm

# What a music file says about itself: the fixtures and byte-built tags, damaged files under the sanitizers.
test_local_tags: test_local_tags.cpp ../source/local/local_tags.c ../source/local/local_tags.h $(wildcard fixtures/music/*)
	$(CC) -O1 -g -Wall -Wextra -fsanitize=address,undefined -fno-sanitize-recover=undefined -c -o local_tags_t.o ../source/local/local_tags.c
	$(CXX) -O1 -g -Wall -Wextra -fsanitize=address,undefined -fno-sanitize-recover=undefined -I../source/local -o $@ test_local_tags.cpp local_tags_t.o

# A music file decoded to 48 kHz stereo: the fixtures, built WAVE files, failing and damaged files; sanitizers on.
test_local_audio: test_local_audio.cpp minimp3_impl.c ../source/local/local_audio.c ../source/local/local_audio.h ../source/local/local_tags.c \
        ../source/audio/flac_dec.c ../source/audio/chan_map.c ../source/audio/resample.c $(wildcard fixtures/music/*)
	for f in ../source/local/local_audio.c ../source/local/local_tags.c ../source/audio/flac_dec.c ../source/audio/chan_map.c ../source/audio/resample.c minimp3_impl.c; do \
	    $(CC) -O1 -g -Wall -Wextra -fsanitize=address,undefined -fno-sanitize-recover=undefined -I../source/audio -I../source/local -c -o $$(basename $$f .c)_a.o $$f || exit 1; done
	$(CXX) -O1 -g -Wall -Wextra -fsanitize=address,undefined -fno-sanitize-recover=undefined -I../source/local -o $@ test_local_audio.cpp \
	    local_audio_a.o local_tags_a.o flac_dec_a.o chan_map_a.o resample_a.o minimp3_impl_a.o -lm

# A folder of music files as an album: order, names, the cover registry (threads, sanitizers).
test_local_music: test_local_music.cpp ../source/local/local_music.c ../source/local/local_music.h ../source/local/lfs_path.cpp ../source/local/lfs_path.h
	$(CC) -O1 -g -Wall -Wextra -fsanitize=address,undefined -fno-sanitize-recover=undefined -I../source/local -I../source/i18n -c -o local_music_t.o ../source/local/local_music.c
	$(CXX) -O1 -g -Wall -Wextra -fsanitize=address,undefined -fno-sanitize-recover=undefined -I../source/local -c -o lfs_path_m.o ../source/local/lfs_path.cpp
	$(CXX) -O1 -g -Wall -Wextra -fsanitize=address,undefined -fno-sanitize-recover=undefined -I../source/local -o $@ test_local_music.cpp local_music_t.o lfs_path_m.o ../source/i18n/i18n.c ../source/i18n/i18n_tables.c -lpthread

# The music engine on files from a drive: music/music_player.cpp itself, with pthreads and a recording sound card for the console's services (hoststub_music/).
MENG_SRC = ../source/local/local_audio.c ../source/local/local_tags.c ../source/audio/flac_dec.c ../source/audio/chan_map.c ../source/audio/resample.c minimp3_impl.c
MENG_INC = -Ihoststub_music -Ihoststub -I../source/music -I../source/audio -I../source/local -I../source/util -I../source/player/stream -I../source/video -I../source/ui/render
test_music_engine: test_music_engine.cpp ../source/music/music_player.cpp ../source/music/music_player.h $(MENG_SRC) ../source/local/lfs_path.cpp $(wildcard fixtures/music/*) $(wildcard hoststub_music/*) $(wildcard hoststub_music/*/*)
	for f in $(MENG_SRC); do $(CC) -O1 -g -Wall -fsanitize=address,undefined -fno-sanitize-recover=undefined -I../source/audio -I../source/local -c -o me_$$(basename $$f .c).o $$f || exit 1; done
	$(CXX) -O1 -g -Wall -fsanitize=address,undefined -fno-sanitize-recover=undefined $(MENG_INC) -c -o me_lfs_path.o ../source/local/lfs_path.cpp
	$(CXX) -O1 -g -Wall -fsanitize=address,undefined -fno-sanitize-recover=undefined $(MENG_INC) -o $@ test_music_engine.cpp ../source/music/music_player.cpp me_*.o -lpthread -lm

# The music decoders built little-endian (the host) and big-endian (the PS3's byte order, run under qemu-ppc64) and compared:
# tags and properties exactly, samples to a hair (see cmp_floats.c).  Skipped when the cross compiler is missing.
.PHONY: endian_music
endian_music: test_local_audio_endian.c cmp_floats.c $(MENG_SRC) ../source/local/local_audio.h $(wildcard fixtures/music/*)
	$(CC) -O2 -Wall -I../source/audio -I../source/local -o em_le test_local_audio_endian.c $(MENG_SRC) -lm
	$(CC) -O2 -Wall -o cmp_floats cmp_floats.c -lm
	./em_le em_le.txt em_le.bin fixtures/music
	@if command -v $(PPC64CC) >/dev/null && command -v $(QEMU_PPC64) >/dev/null; then \
	    $(PPC64CC) -static -O2 -ffp-contract=off -Wall -I../source/audio -I../source/local -o em_be test_local_audio_endian.c $(MENG_SRC) -lm && \
	    $(QEMU_PPC64) ./em_be em_be.txt em_be.bin fixtures/music && \
	    cmp em_le.txt em_be.txt && ./cmp_floats em_le.bin em_be.bin 2e-6 && echo 'music decoders: big-endian run agrees'; \
	else echo 'endian_music: no powerpc64 cross compiler or qemu-ppc64, skipped'; fi

# Sample-rate conversion to the port's 48 kHz.
test_resample: test_resample.cpp ../source/audio/resample.c ../source/audio/resample.h
	$(CC) $(CFLAGS) -O2 -Wextra -c -o resample_host.o ../source/audio/resample.c
	$(CXX) $(CXXFLAGS) -Wextra -I../source/audio -o $@ test_resample.cpp resample_host.o -lm

# The subtitles of a Matroska file end to end: mkv_ts, the sink, the conversions, the player's subtitles.cpp.
test_local_subs: test_local_subs.cpp mkv_builder.h ../source/player/subtitles.cpp ../source/local/local_subs.cpp ../source/local/sub_conv.c ../source/video/mkv_ts.cpp
	$(CC) $(CFLAGS) -c -o sub_conv_s.o ../source/local/sub_conv.c
	$(CC) $(CFLAGS) -c -o subs_pgs_s.o ../source/player/subtitles_pgs.c
	$(CC) $(CFLAGS) -c -o aac_adts_s.o ../source/audio/aac_adts.c
	$(CC) $(CFLAGS) -c -o flac_dec_s.o ../source/audio/flac_dec.c
	$(CC) $(CFLAGS) -O2 -c -o resample_s.o ../source/audio/resample.c
	$(CXX) $(CXXFLAGS) -Wextra -Ihoststub -I../source/local -I../source/video -I../source/util -I../source/audio -I../source/player -o $@ test_local_subs.cpp ../source/local/local_subs.cpp \
	    ../source/video/mkv_ts.cpp ../source/video/mkv_demux.cpp sub_conv_s.o subs_pgs_s.o aac_adts_s.o flac_dec_s.o resample_s.o -lm

# Matroska subtitle blocks as text and as .sup segments.
test_sub_conv: test_sub_conv.cpp ../source/local/sub_conv.c ../source/local/sub_conv.h
	$(CC) $(CFLAGS) -Wextra -I../source/local -c -o sub_conv_host.o ../source/local/sub_conv.c
	$(CXX) $(CXXFLAGS) -Wextra -I../source/local -o $@ test_sub_conv.cpp sub_conv_host.o

# The Media browser's names for files, and its resume table.
test_local_names: test_local_names.cpp ../source/local/local_names.c ../source/local/local_names.h
	$(CC) $(CFLAGS) -Wextra -I../source/local -c -o local_names_host.o ../source/local/local_names.c
	$(CXX) $(CXXFLAGS) -Wextra -I../source/local -o $@ test_local_names.cpp local_names_host.o ../source/i18n/i18n.c ../source/i18n/i18n_tables.c

